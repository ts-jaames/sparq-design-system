{
  "$description": "Sparq visual register. Near-black ground, warm ink, one accent, hairlines. Source of truth for sparq-tokens.css and sparq-tokens.json.",
  "color": {
    "ground": {
      "$type": "color",
      "$value": "#1A1A1A",
      "$description": "Near-black app ground. Never pure black, never a warm brown shell."
    },
    "ink": {
      "$type": "color",
      "$value": "#EDEAE4",
      "$description": "Primary text. Warmth lives here, not in the background."
    },
    "ink-bright": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Section titles only. Body text stays in ink."
    },
    "ink-soft": {
      "$type": "color",
      "$value": "#C4BEB4",
      "$description": "Secondary prose."
    },
    "ink-muted": {
      "$type": "color",
      "$value": "#A8A39A",
      "$description": "Labels and metadata."
    },
    "ink-faint": {
      "$type": "color",
      "$value": "#949089",
      "$description": "Floor for any text, including small mono labels."
    },
    "rule": {
      "$type": "color",
      "$value": "rgba(237, 234, 228, 0.12)",
      "$description": "Default hairline."
    },
    "rule-strong": {
      "$type": "color",
      "$value": "rgba(237, 234, 228, 0.22)",
      "$description": "Hairline that must read. Still a hairline, not a border treatment."
    },
    "accent": {
      "$type": "color",
      "$value": "#E75437",
      "$description": "The only accent. Marks the one thing to look at."
    },
    "accent-deep": {
      "$type": "color",
      "$value": "#F07A62",
      "$description": "Accent used for a word that must stay on the ground."
    },
    "accent-soft": {
      "$type": "color",
      "$value": "rgba(231, 84, 55, 0.18)",
      "$description": "Accent wash. Not a filled button."
    },
    "accent-wash": {
      "$type": "color",
      "$value": "rgba(231, 84, 55, 0.10)",
      "$description": "Quieter accent wash."
    },
    "raise": {
      "$type": "color",
      "$value": "rgba(237, 234, 228, 0.05)",
      "$description": "Neutral lift off the ground for hover and selected rows. Never a tinted or brown surface, and never a card."
    },
    "overlay": {
      "$type": "color",
      "$value": "rgba(14, 14, 14, 0.88)",
      "$description": "Tooltips, popovers, menus, and dialogs. A shade darker than the ground, near-opaque, over a backdrop blur. Never brown."
    }
  },
  "effect": {
    "overlay-blur": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Backdrop blur behind --sparq-overlay."
    }
  },
  "space": {
    "s1": { "$type": "dimension", "$value": "8px" },
    "s2": { "$type": "dimension", "$value": "16px" },
    "s3": { "$type": "dimension", "$value": "24px" },
    "s4": { "$type": "dimension", "$value": "32px" },
    "s5": { "$type": "dimension", "$value": "40px" },
    "s6": { "$type": "dimension", "$value": "48px" },
    "s8": { "$type": "dimension", "$value": "64px" },
    "s10": { "$type": "dimension", "$value": "80px" }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Sans",
        "system-ui",
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "Helvetica",
        "Arial",
        "sans-serif"
      ],
      "$description": "Prose, questions, titles."
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Mono",
        "ui-monospace",
        "SFMono-Regular",
        "SF Mono",
        "Menlo",
        "Consolas",
        "monospace"
      ],
      "$description": "Labels, states, stamps, ranges, counts."
    }
  },
  "typography": {
    "track-label": {
      "$type": "dimension",
      "$value": "0.08em",
      "$description": "Tracking for the mono label voice only."
    },
    "measure": {
      "$type": "dimension",
      "$value": "62ch",
      "$description": "Maximum prose measure."
    },
    "title-tracking": {
      "$type": "dimension",
      "$value": "-0.015em"
    },
    "focus-width": {
      "$type": "dimension",
      "$value": "2px"
    },
    "focus-offset": {
      "$type": "dimension",
      "$value": "3px"
    },
    "hit-min": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "WCAG 2.2 target size minimum."
    }
  },
  "motion": {
    "ease": {
      "$type": "cubicBezier",
      "$value": [0.22, 0.61, 0.36, 1]
    },
    "duration": {
      "$type": "duration",
      "$value": "280ms"
    }
  },
  "contrast": {
    "ink-on-ground": {
      "$type": "sparq.contrast",
      "$value": {
        "foreground": "{color.ink}",
        "background": "{color.ground}",
        "minRatio": 4.5,
        "allowed": true,
        "role": "text"
      }
    },
    "ink-soft-on-ground": {
      "$type": "sparq.contrast",
      "$value": {
        "foreground": "{color.ink-soft}",
        "background": "{color.ground}",
        "minRatio": 4.5,
        "allowed": true,
        "role": "text"
      }
    },
    "ink-muted-on-ground": {
      "$type": "sparq.contrast",
      "$value": {
        "foreground": "{color.ink-muted}",
        "background": "{color.ground}",
        "minRatio": 4.5,
        "allowed": true,
        "role": "text"
      }
    },
    "ink-faint-on-ground": {
      "$type": "sparq.contrast",
      "$value": {
        "foreground": "{color.ink-faint}",
        "background": "{color.ground}",
        "minRatio": 4.5,
        "allowed": true,
        "role": "text"
      }
    },
    "accent-on-ground": {
      "$type": "sparq.contrast",
      "$value": {
        "foreground": "{color.accent}",
        "background": "{color.ground}",
        "minRatio": 4.5,
        "allowed": true,
        "role": "text"
      }
    },
    "accent-deep-on-ground": {
      "$type": "sparq.contrast",
      "$value": {
        "foreground": "{color.accent-deep}",
        "background": "{color.ground}",
        "minRatio": 4.5,
        "allowed": true,
        "role": "text"
      }
    },
    "ink-bright-on-ground": {
      "$type": "sparq.contrast",
      "$value": {
        "foreground": "{color.ink-bright}",
        "background": "{color.ground}",
        "minRatio": 4.5,
        "allowed": true,
        "role": "text"
      }
    },
    "ground-on-accent-deep": {
      "$type": "sparq.contrast",
      "$value": {
        "foreground": "{color.ground}",
        "background": "{color.accent-deep}",
        "minRatio": 4.5,
        "allowed": true,
        "role": "text",
        "note": "The filled primary at rest."
      }
    },
    "ground-on-accent": {
      "$type": "sparq.contrast",
      "$value": {
        "foreground": "{color.ground}",
        "background": "{color.accent}",
        "minRatio": 4.5,
        "allowed": true,
        "role": "text",
        "note": "The filled primary on hover."
      }
    },
    "white-on-accent": {
      "$type": "sparq.contrast",
      "$value": {
        "foreground": "{color.ink-bright}",
        "background": "{color.accent}",
        "minRatio": 4.5,
        "allowed": false,
        "role": "text",
        "note": "Disallowed. White text on the accent fill is under 4.5:1. The filled primary uses ground text."
      }
    },
    "accent-hairline-on-ground": {
      "$type": "sparq.contrast",
      "$value": {
        "foreground": "{color.accent}",
        "background": "{color.ground}",
        "minRatio": 3,
        "allowed": true,
        "role": "non-text"
      }
    },
    "accent-on-ink": {
      "$type": "sparq.contrast",
      "$value": {
        "foreground": "{color.accent}",
        "background": "{color.ink}",
        "minRatio": 4.5,
        "allowed": false,
        "role": "text",
        "note": "Disallowed. Accent text sits on the ground, not on the off-white ink."
      }
    }
  }
}
